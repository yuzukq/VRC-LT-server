# Discord bot token (Discord Developer Portalで取得)
DISCORD_TOKEN=your_bot_token_here

# PDFを受け付けるチャンネルのID (右クリック→IDをコピー)
CHANNEL_ID=123456789012345678

# Cloudflare R2
# R2_ACCOUNT_ID: バケットの「設定」タブに表示されるS3 APIエンドポイント
#   (https://<ACCOUNT_ID>.r2.cloudflarestorage.com) の <ACCOUNT_ID> 部分
R2_ACCOUNT_ID=your_account_id
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: 「R2 APIトークンを管理する」から
#   オブジェクトの読み取りと書き込み権限で作成 (Secretは作成時のみ表示)
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_key
# R2_BUCKET_NAME: 作成したバケット名
R2_BUCKET_NAME=vrc-lt
# R2_PUBLIC_URL: バケットの公開URL、またはカスタムドメイン
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# アップロード上限 (MB)
MAX_FILE_MB=50
