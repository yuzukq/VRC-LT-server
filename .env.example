# Discord bot token (Discord Developer Portalで取得)
DISCORD_TOKEN=your_bot_token_here

# PDFを受け付けるチャンネルのID (右クリック→IDをコピー)
CHANNEL_ID=123456789012345678

# MP4の公開ベースURL (末尾スラッシュなし)
BASE_URL=https://lt.example.com

# MP4を保存するディレクトリ (nginxのrootと合わせる)
VIDEO_DIR=/opt/vrc-lt/videos

# アップロード上限 (MB)
MAX_FILE_MB=50
