# Discord bot token (Discord Developer Portalで取得)
DISCORD_TOKEN=your_bot_token_here

# PDFを受け付けるチャンネルのID (右クリック→IDをコピー)
CHANNEL_ID=123456789012345678

# Cloudflare R2
R2_ACCOUNT_ID=your_account_id         # CloudflareダッシュボードのAccount ID
R2_ACCESS_KEY_ID=your_access_key_id   # R2 → APIトークン で生成
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=vrc-lt                  # 作成するバケット名
R2_PUBLIC_URL=https://pub-xxx.r2.dev  # バケットの公開URL

# アップロード上限 (MB)
MAX_FILE_MB=50
